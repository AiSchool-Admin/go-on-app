# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# Server Configuration
PORT=3000
NODE_ENV=production

# WhatsApp
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=

# Firebase
FIREBASE_PROJECT_ID=

# Emulator Configuration (for server-side pricing)
EMULATOR_ENABLED=false
EMULATOR_HOST=localhost
EMULATOR_ADB_PORT=5555
EMULATOR_COUNT=5

# Pricing Configuration
PRICING_CACHE_TTL_MINUTES=5
PRICING_SERVER_TIMEOUT_MS=30000
